#!/usr/bin/env python3
"""
Minimum glibc an ELF binary needs, and whether RHEL 7/8 can load it.

Created/Changed using: Claude Web
HUMAN VERIFICATION: Basic working confirmed.
"""

import re
import subprocess
import sys

DISTROS = {"rhel7": (2, 17), "rhel8": (2, 28), "rhel9": (2, 34)}

# TODO(agent): libstdc++ floors (GLIBCXX_/CXXABI_) are a separate
# constraint. Same regex approach, but needs a version->GCC lookup
# table, and devtoolset builds can satisfy a newer GLIBCXX than the
# base system libstdc++ provides.


def floor(path):
    """Return the minimum glibc version an ELF binary needs, or None if it has no versioned symbols."""
    out = subprocess.run(
        ["readelf", "--dyn-syms", "--wide", path],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    tags = re.findall(r"GLIBC_([\d.]+)", out)
    if not tags:
        return None
    return max(tuple(int(p) for p in t.rstrip(".").split(".")) for t in tags)


bad = False
for path in sys.argv[1:]:
    need = floor(path)
    if need is None:
        print(f"{path}: no versioned glibc symbols")
        continue
    verdict = {d: need <= v for d, v in DISTROS.items()}
    bad |= not all(verdict.values())
    shown = ".".join(map(str, need))
    flags = "  ".join(f"{d}={'ok' if o else 'NO'}" for d, o in verdict.items())
    print(f"{path}: needs glibc {shown}  {flags}")

sys.exit(1 if bad else 0)
