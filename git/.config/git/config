[alias]
    c = commit -am
    fpush = push --force
    s = status
    sclone = clone --depth=1
    undocommit = reset HEAD~
    hreset = reset --hard
    co = checkout

[core]
    pager = delta
    editor = nvim

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = simple           # Push current branch to upstream branch of same name
    autoSetupRemote = true     # Auto-create upstream tracking branch when pushing
    followTags = true          # Include tags related to pushed branches

[fetch]
    prune = true               # Remove local references to deleted remote branches
    pruneTags = true           # Remove local tags that no longer exist on remote
    all = true                 # Fetch from all remotes by default

[help]
    autocorrect = prompt       # Suggest corrections for mistyped commands

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictStyle = diff3

; Force GitHub to use SSH
[url "git@github.com:"]
    insteadOf = https://github.com/ # Convert HTTPS GitHub URLs to SSH automatically

[log]
    date = human

# INCLUDES
# --------
# Local/Private config goes in the include
[include]
    path = ~/.gitconfig.local
    path = ~/.config/delta/themes.gitconfig
# COLORS
# ------
# Dracula Dark Theme
[color]
    ui = auto
[color "branch"]
    current = cyan bold reverse
    local = white
    plain =
    remote = cyan
[color "diff"]
    commit =
    func = cyan
    plain =
    whitespace = magenta reverse
    meta = white
    frag = cyan bold reverse
    old = red
    new = green
[color "grep"]
    context =
    filename =
    function =
    linenumber = white
    match =
    selected =
    separator =
[color "interactive"]
    error =
    header =
    help =
    prompt =
[color "status"]
    added = green
    changed = yellow
    header =
    localBranch =
    nobranch =
    remoteBranch = cyan bold
    unmerged = magenta bold reverse
    untracked = red
    updated = green bold

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    features = decorations
    # features = side-by-side decorations
    line-numbers = true
    # features = kingfisher
[delta]
    syntax-theme = Dracula
    plus-style = syntax "#003800"
    minus-style = syntax "#3f0001"

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none
    hunk-header-decoration-style = cyan box ul

[delta "line-numbers"]
    line-numbers-left-style = cyan
    line-numbers-right-style = cyan
    line-numbers-minus-style = 124
    line-numbers-plus-style = 28
