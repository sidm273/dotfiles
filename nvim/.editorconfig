# EditorConfig is awesome: https://editorconfig.org
# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
max_line_length = 100
spelling_language = en-us
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 79

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.fish]
indent_style = space
indent_size = 4

[*.{il,ils,scm},{.cdsinit,.cdsenv}]
indent_style = space
indent_size = 2

[*.{scm,ss}]
indent_style = space
indent_size = 2

[*.lua]
indent_style = space
indent_size = 2
max_line_length = 160

[*.vim]
indent_style = space
indent_size = 2
max_line_length = 80

[justfile]
indent_style = space
indent_size = 4
max_line_length = 80

[*.toml]
indent_style = space
indent_size = 2
max_line_length = 80

[*.ron]
indent_style = space
indent_size = 4

[*.tcsh,*.csh]
indent_style = space
indent_size = 2

[*.rb]
indent_size = 2
