# Specify desired highlighting theme.
# Run `bat --list-themes`
# for a list of all available themes
# Run `bat cache` on new machines to register a custom theme.
# Default theme
# --theme="OneHalfDark"
--theme="Dracula_pink"

# Uncomment the following line to disable automatic paging:
# --paging=never
# Disabled builtin pager since less is working better?
# --pager=builtin
# Squeeze consecutive empty lines into a single empty line.
--squeeze-blank
# Syntax mappings: map a certain filename pattern to a language.
#   Example 1: use the C++ syntax for Arduino .ino files
#   Example 2: Use ".gitignore"-style highlighting for ".ignore" files
#--map-syntax "*.ino:C++"
#--map-syntax ".ignore:Git Ignore"
# Cadence SKILL specific settings.
--map-syntax ".cdsinit:Lisp"
--map-syntax ".cdsenv:Lisp"
--map-syntax "*.il:Lisp"
--map-syntax "*.ils:Lisp"
--map-syntax "*.fnd:Lisp"
# Verilog-A
--map-syntax "*.va:Verilog"
