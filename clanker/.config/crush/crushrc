if [[ -f .env ]]; then
    set -a
    source .env
    set +a
fi

provider add ollama \
	--name "Ollama Cloud" \
	--type openai-compat \
	--base-url "https://ollama.com/v1" \
	--discover-models true \
	--api-key "$OLLAMA_API_KEY"

model add ollama/glm-5.3-flash
model large ollama/gpt-oss:120b

lsp add ty --command ty --args server --filetypes python
lsp add ruff --command ruff --args server --filetypes python
lsp add fish --command fish-lsp --args start --filetypes fish

